# URL web app Apps Script (Deploy > Manage deployments, berakhiran /exec)
APPS_SCRIPT_URL=
# API key dari menu Google Sheet: Laporan QA > Buat API key untuk Vercel
APPS_SCRIPT_KEY=
# Rahasia untuk menandatangani sesi login. WAJIB diganti di produksi.
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Opsional: link Google Sheet untuk tombol di halaman Admin
SHEET_URL=

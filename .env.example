# Isi file JSON key Service Account Google (tempel apa adanya, atau base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID Google Sheet: bagian URL di antara /d/ dan /edit
SHEET_ID=
# Rahasia untuk menandatangani sesi login. WAJIB diganti di produksi.
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Opsional: link Google Sheet untuk tombol di halaman Admin
SHEET_URL=
